diff --git a/src/platform/linux/mic_redirect.cpp b/src/platform/linux/mic_redirect.cpp
new file mode 100644
index 00000000..9458ac54
--- /dev/null
+++ b/src/platform/linux/mic_redirect.cpp
@@ -0,0 +1,550 @@
+/**
+ * @file src/platform/linux/mic_redirect.cpp
+ * @brief PipeWire virtual microphone fed by client microphone audio.
+ *
+ * The host exposes one virtual source, `sunshine-mic`, that applications select as a
+ * microphone. It is created by `libpipewire-module-combine-stream` in `source` mode and
+ * fed by a private PipeWire stream carrying mono 48 kHz signed 16-bit PCM, so no module
+ * or config file has to be installed on the host.
+ */
+// standard includes
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <chrono>
+#include <cstring>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// lib includes
+#include <pipewire/impl.h>
+#include <pipewire/pipewire.h>
+#include <spa/param/audio/format-utils.h>
+#include <spa/param/audio/raw.h>
+#include <spa/pod/builder.h>
+#include <spa/utils/keys.h>
+#include <spa/param/audio/raw-utils.h>
+
+// local includes
+#include "mic_redirect.h"
+#include "src/logging.h"
+
+namespace platf::mic_redirect {
+  using namespace std::literals;
+
+  namespace {
+    /// Node name applications select as the microphone.
+    constexpr auto source_node_name = "sunshine-mic";
+    /// Description shown for the microphone in device pickers.
+    constexpr auto source_node_description = "Sunshine Microphone";
+    /// Node name of the private stream that feeds the microphone.
+    constexpr auto feed_node_name = "sunshine-mic-feed";
+    /// Frames buffered between the receive thread and the graph. The graph pulls in whole
+    /// driver buffers, which can be far larger than one microphone frame, so the buffer has
+    /// to hold enough audio to satisfy one pull.
+    constexpr std::size_t ring_frames = sample_rate / 1000 * 400;
+    /// SPA node behind the virtual source: an adapter over a null sink, whose input ports accept
+    /// the audio pushed into it.
+    constexpr auto null_audio_sink_factory = "support.null-audio-sink";
+    /// Media class of that node. It has to be a source so that applications select the microphone
+    /// itself: as a sink they would only see its monitor, labelled "Monitor of ...".
+    constexpr auto virtual_source_class = "Audio/Source/Virtual";
+    /// Factory that creates the link delivering our audio into the virtual source.
+    constexpr auto link_factory = "link-factory";
+
+    /**
+     * @brief Single-producer single-consumer ring of mono 16-bit frames.
+     *
+     * The receive thread pushes whole frames, the graph thread pops what it needs and
+     * pads with silence, so a producer never blocks on a stalled graph.
+     */
+    struct ring_t {
+      std::vector<std::int16_t> data {ring_frames};  ///< Backing storage.
+      std::atomic<std::size_t> head {0};  ///< Next write index, monotonically increasing.
+      std::atomic<std::size_t> tail {0};  ///< Next read index, monotonically increasing.
+
+      /**
+       * @brief Append a whole frame, discarding the oldest audio if it does not fit.
+       * @return The frame count stored.
+       */
+      std::size_t push(const std::int16_t *samples, std::size_t count) {
+        const auto write = head.load(std::memory_order_relaxed);
+        auto read = tail.load(std::memory_order_acquire);
+
+        if (count >= ring_frames) {
+          // Keep the newest audio when a frame cannot fit at all.
+          read = write + count - ring_frames;
+        }
+        else if (write - read > ring_frames - count) {
+          // Discard the oldest audio instead of the newest: keeping the buffer full of stale
+          // audio would add latency that never drains.
+          read = write - (ring_frames - count);
+        }
+
+        tail.store(read, std::memory_order_release);
+
+        for (std::size_t i = 0; i < count; ++i) {
+          data[(write + i) % ring_frames] = samples[i];
+        }
+
+        head.store(write + count, std::memory_order_release);
+        return count;
+      }
+
+      /**
+       * @brief Pop up to `count` frames.
+       * @return The frame count read.
+       */
+      std::size_t pop(std::int16_t *out, std::size_t count) {
+        const auto read = tail.load(std::memory_order_relaxed);
+        const auto have = std::min(count, head.load(std::memory_order_acquire) - read);
+
+        for (std::size_t i = 0; i < have; ++i) {
+          out[i] = data[(read + i) % ring_frames];
+        }
+
+        tail.store(read + have, std::memory_order_release);
+        return have;
+      }
+    };
+
+
+    /**
+     * @brief Lifecycle of the PipeWire virtual source and its feed stream.
+     */
+    struct device_t {
+      pw_thread_loop *loop {nullptr};  ///< Owns the PipeWire main loop thread.
+      pw_context *context {nullptr};  ///< PipeWire context created on that loop.
+      pw_core *core {nullptr};  ///< Connection to the PipeWire daemon.
+      pw_registry *registry {nullptr};  ///< Registry used to learn the global ids of both nodes.
+      pw_registry_events registry_events {};  ///< Callbacks for registry globals.
+      spa_hook registry_listener {};  ///< Listener registered for those callbacks.
+      std::atomic<std::uint32_t> source_node_id {PW_ID_ANY};  ///< Global id of the virtual source.
+      std::atomic<std::uint32_t> feed_node_id {PW_ID_ANY};  ///< Global id of our feed stream node.
+      std::atomic<std::uint32_t> source_port_id {PW_ID_ANY};  ///< Global id of the source's input port.
+      std::atomic<std::uint32_t> feed_port_id {PW_ID_ANY};  ///< Global id of the stream's output port.
+      pw_proxy *source_node {nullptr};  ///< Proxy for the node applications capture as a microphone.
+      pw_proxy *link {nullptr};  ///< Link delivering the feed stream into the virtual source.
+      pw_stream *stream {nullptr};  ///< Private stream writing into the virtual source.
+      pw_stream_events events {};  ///< Callbacks, kept alive for the stream's lifetime.
+      spa_hook stream_listener {};  ///< Listener registered for those callbacks.
+      ring_t ring;  ///< Audio waiting for the graph to consume it.
+      std::mutex mutex;  ///< Serializes init(), release() and write().
+      std::atomic<bool> connected {false};  ///< Whether the feed stream is streaming.
+      std::atomic<bool> failed {false};  ///< Whether PipeWire reported an error for the feed.
+      bool failure_logged {false};  ///< Whether the current failure has been reported.
+    };
+
+    device_t device;
+
+    /**
+     * @brief Fill one graph buffer from the ring, padding with silence.
+     */
+    void on_process(void *userdata) {
+      auto *self = static_cast<device_t *>(userdata);
+
+      auto *buffer = pw_stream_dequeue_buffer(self->stream);
+      if (!buffer) {
+        return;
+      }
+
+      auto *spa_buffer = &buffer->buffer->datas[0];
+      spa_buffer->chunk->offset = 0;
+      spa_buffer->chunk->stride = sizeof(std::int16_t);
+
+      const auto requested = spa_buffer->maxsize / sizeof(std::int16_t);
+      auto *destination = static_cast<std::int16_t *>(spa_buffer->data);
+      if (!destination || requested == 0) {
+        spa_buffer->chunk->size = 0;
+        pw_stream_queue_buffer(self->stream, buffer);
+        return;
+      }
+
+      const auto filled = self->ring.pop(destination, requested);
+      if (filled < requested) {
+        std::memset(destination + filled, 0, (requested - filled) * sizeof(std::int16_t));
+      }
+
+      spa_buffer->chunk->size = requested * sizeof(std::int16_t);
+      pw_stream_queue_buffer(self->stream, buffer);
+    }
+
+    /**
+     * @brief Learn the global ids of the virtual source and of our own feed stream.
+     *
+     * A node created from the adapter factory, and a stream's node, are only addressable by the
+     * ids the registry reports, which is what the link is created with.
+     */
+    void on_registry_global(void *userdata, uint32_t id, uint32_t /*permissions*/, const char *type, uint32_t /*version*/, const spa_dict *props) {
+      auto *self = static_cast<device_t *>(userdata);
+      if (!type || !props) {
+        return;
+      }
+
+
+      if (std::strcmp(type, PW_TYPE_INTERFACE_Node) == 0) {
+        const auto *name = spa_dict_lookup(props, PW_KEY_NODE_NAME);
+        if (!name) {
+          return;
+        }
+
+        if (std::strcmp(name, source_node_name) == 0) {
+          self->source_node_id.store(id, std::memory_order_release);
+        }
+        else if (std::strcmp(name, feed_node_name) == 0) {
+          self->feed_node_id.store(id, std::memory_order_release);
+        }
+        else {
+          return;
+        }
+      }
+      else if (std::strcmp(type, PW_TYPE_INTERFACE_Port) == 0) {
+        // A port carries no node name, but its object.path starts with the node name. The
+        // trailing colon keeps "sunshine-mic" from matching the "sunshine-mic-feed" stream.
+        const auto *path = spa_dict_lookup(props, SPA_KEY_OBJECT_PATH);
+        const auto *direction = spa_dict_lookup(props, PW_KEY_PORT_DIRECTION);
+        if (!path || !direction || std::strcmp(direction, "out") != 0) {
+          if (!path || !direction || std::strcmp(direction, "in") != 0) {
+            return;
+          }
+        }
+
+        const std::string_view object_path {path};
+        if (std::strcmp(direction, "out") == 0 && object_path.rfind(std::string {feed_node_name} + ":", 0) == 0) {
+          self->feed_port_id.store(id, std::memory_order_release);
+        }
+        else if (std::strcmp(direction, "in") == 0 && object_path.rfind(std::string {source_node_name} + ":", 0) == 0) {
+          self->source_port_id.store(id, std::memory_order_release);
+        }
+        else {
+          return;
+        }
+      }
+      else {
+        return;
+      }
+
+      pw_thread_loop_signal(self->loop, false);
+    }
+
+    /**
+     * @brief Track whether the feed stream still accepts audio.
+     */
+    void on_stream_state_changed(void *userdata, pw_stream_state /*old_state*/, pw_stream_state state, const char *error) {
+      auto *self = static_cast<device_t *>(userdata);
+
+      switch (state) {
+        case PW_STREAM_STATE_STREAMING:
+          self->connected.store(true, std::memory_order_release);
+          self->failed.store(false, std::memory_order_release);
+          break;
+        case PW_STREAM_STATE_ERROR:
+          BOOST_LOG(warning) << "PipeWire microphone feed error: "sv << (error ? error : "unknown");
+          self->connected.store(false, std::memory_order_release);
+          self->failed.store(true, std::memory_order_release);
+          break;
+        case PW_STREAM_STATE_UNCONNECTED:
+          self->connected.store(false, std::memory_order_release);
+          break;
+        default:
+          break;
+      }
+    }
+
+    /**
+     * @brief Report a failure to build the virtual microphone.
+     *
+     * The receive thread retries with backoff for as long as a session is registered, so
+     * only the first failure of an episode is logged.
+     *
+     * @param reason Short description of the failed step.
+     */
+    void log_failure(std::string_view reason) {
+      if (device.failure_logged) {
+        BOOST_LOG(debug) << "Virtual microphone unavailable: "sv << reason;
+        return;
+      }
+
+      device.failure_logged = true;
+      BOOST_LOG(warning) << "Couldn't create the virtual microphone: "sv << reason
+                         << " (client microphone audio will be unavailable)"sv;
+    }
+
+    /**
+     * @brief Destroy the stream, module and core connection.
+     *
+     * The caller must hold the PipeWire loop lock when the loop is running.
+     */
+    void destroy() {
+      if (device.link) {
+        pw_proxy_destroy(device.link);
+        device.link = nullptr;
+      }
+      if (device.stream) {
+        pw_stream_destroy(device.stream);
+        device.stream = nullptr;
+      }
+      if (device.source_node) {
+        pw_proxy_destroy(device.source_node);
+        device.source_node = nullptr;
+      }
+      if (device.registry) {
+        spa_hook_remove(&device.registry_listener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy *>(device.registry));
+        device.registry = nullptr;
+      }
+      device.source_node_id.store(PW_ID_ANY, std::memory_order_release);
+      device.feed_node_id.store(PW_ID_ANY, std::memory_order_release);
+      device.source_port_id.store(PW_ID_ANY, std::memory_order_release);
+      device.feed_port_id.store(PW_ID_ANY, std::memory_order_release);
+      if (device.core) {
+        pw_core_disconnect(device.core);
+        device.core = nullptr;
+      }
+      device.connected.store(false, std::memory_order_release);
+      device.failed.store(false, std::memory_order_release);
+    }
+  }  // namespace
+
+  int init() {
+    std::lock_guard<std::mutex> lock(device.mutex);
+    if (device.stream) {
+      return 0;
+    }
+
+    pw_init(nullptr, nullptr);
+
+    device.loop = pw_thread_loop_new("sunshine-mic", nullptr);
+    if (!device.loop) {
+      log_failure("couldn't create the PipeWire thread loop"sv);
+      return -1;
+    }
+
+    device.context = pw_context_new(pw_thread_loop_get_loop(device.loop), nullptr, 0);
+    if (!device.context) {
+      log_failure("couldn't create the PipeWire context"sv);
+      pw_thread_loop_destroy(device.loop);
+      device.loop = nullptr;
+      return -1;
+    }
+
+    if (pw_thread_loop_start(device.loop) < 0) {
+      log_failure("couldn't start the PipeWire thread loop"sv);
+      pw_context_destroy(device.context);
+      device.context = nullptr;
+      pw_thread_loop_destroy(device.loop);
+      device.loop = nullptr;
+      return -1;
+    }
+
+    pw_thread_loop_lock(device.loop);
+
+    // Tear everything down from the locked context: PipeWire objects may only be destroyed
+    // while the thread loop lock is held.
+    const auto abandon = [](std::string_view reason) {
+      log_failure(reason);
+      destroy();
+      pw_thread_loop_unlock(device.loop);
+      pw_context_destroy(device.context);
+      device.context = nullptr;
+      pw_thread_loop_stop(device.loop);
+      pw_thread_loop_destroy(device.loop);
+      device.loop = nullptr;
+      return -1;
+    };
+
+    device.core = pw_context_connect(device.context, nullptr, 0);
+    if (!device.core) {
+      return abandon("couldn't connect to the PipeWire daemon"sv);
+    }
+
+    // The registry has to exist before the nodes are created, so the events announcing them are
+    // delivered to us.
+    device.registry = pw_core_get_registry(device.core, PW_VERSION_REGISTRY, 0);
+    if (device.registry) {
+      device.registry_events = {};
+      device.registry_events.version = PW_VERSION_REGISTRY_EVENTS;
+      device.registry_events.global = on_registry_global;
+      pw_registry_add_listener(device.registry, &device.registry_listener, &device.registry_events, &device);
+    }
+
+    // Publish the microphone as a virtual source: applications select it directly as a
+    // microphone, and our own stream is linked into its input.
+    auto *node_properties = pw_properties_new(
+      PW_KEY_FACTORY_NAME, null_audio_sink_factory,
+      PW_KEY_NODE_NAME, source_node_name,
+      PW_KEY_NODE_DESCRIPTION, source_node_description,
+      PW_KEY_MEDIA_CLASS, virtual_source_class,
+      SPA_KEY_AUDIO_POSITION, "MONO",
+      SPA_KEY_AUDIO_CHANNELS, "1",
+      SPA_KEY_AUDIO_RATE, "48000",
+      SPA_KEY_AUDIO_FORMAT, "F32LE",
+      // Drive the graph in small quanta: as the graph driver this node otherwise picks a
+      // buffer far larger than the microphone frame, which would drop most of the audio.
+      PW_KEY_NODE_RATE, "1/48000",
+      PW_KEY_NODE_FORCE_QUANTUM, "960",
+      PW_KEY_OBJECT_LINGER, "true",
+      nullptr);
+
+    device.source_node = static_cast<pw_proxy *>(
+      pw_core_create_object(device.core, "adapter", PW_TYPE_INTERFACE_Node, PW_VERSION_NODE, &node_properties->dict, 0));
+    pw_properties_free(node_properties);
+
+    if (!device.source_node) {
+      return abandon("couldn't create the virtual source node"sv);
+    }
+
+    // pw_core_sync() only queues a round-trip and reports progress through the done event, so the
+    // wait is driven by the registry event that carries the node id.
+    // The nodes and their ports are announced by the registry, and the ports only appear once the
+    // session manager has configured the node, so this waits on wall-clock time rather than on the
+    // number of round-trips: every registry event signals the loop.
+    const auto await = [&](const std::function<bool()> &resolved) {
+      const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+      while (!resolved() && std::chrono::steady_clock::now() < deadline) {
+        pw_thread_loop_timed_wait(device.loop, 1);
+      }
+
+      return resolved();
+    };
+
+    if (!await([&] {
+          return device.source_node_id.load(std::memory_order_acquire) != PW_ID_ANY &&
+                 device.source_port_id.load(std::memory_order_acquire) != PW_ID_ANY;
+        })) {
+      return abandon("couldn't find the PipeWire microphone node"sv);
+    }
