+# Virtual microphone output
+#
+# Client microphone audio is played back into a PipeWire virtual source. This is a separate
+# dependency from the PipeWire capture backends above: a host can capture with X11, KMS or
+# wlroots and still expose a virtual microphone, so probe PipeWire independently.
+pkg_check_modules(PIPEWIRE_MIC libpipewire-0.3)
+if(PIPEWIRE_MIC_FOUND)
+    include_directories(SYSTEM ${PIPEWIRE_MIC_INCLUDE_DIRS})
+    list(APPEND PLATFORM_LIBRARIES ${PIPEWIRE_MIC_LIBRARIES})
+    add_compile_definitions(SUNSHINE_BUILD_MIC_REDIRECT)
+    list(APPEND PLATFORM_TARGET_FILES
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/mic_redirect.cpp"
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/mic_redirect.h")
+endif()
+
 # XDG portal
 set(PORTAL_FOUND OFF)
 if(PIPEWIRE_FOUND AND GIO_FOUND AND ${SUNSHINE_ENABLE_PORTAL})
