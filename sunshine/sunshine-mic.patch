+/**
+ * @file src/platform/linux/mic_redirect.h
+ * @brief PipeWire virtual microphone that plays client microphone audio back to host apps.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace platf::mic_redirect {
+  /// Sample rate of the PCM accepted by write().
+  constexpr std::uint32_t sample_rate = 48000;
+
+  /**
+   * @brief Create the PipeWire microphone that host applications record from.
+   *
+   * Creates `sunshine-mic`, a virtual audio device carrying the frames handed to write(),
+   * and returns once the node exists. Safe to call when a device already exists.
+   *
+   * @return 0 on success, -1 when PipeWire is unavailable or the node could not be created.
+   */
+  int
+  init();
+
+  /**
+   * @brief Destroy the microphone created by init().
+   *
+   * Safe to call when no device was created.
+   */
+  void
+  release();
+
+  /**
+   * @brief Queue one mono 48 kHz signed 16-bit PCM frame for the microphone.
+   *
+   * Never blocks: when the graph is not consuming frames the frame is dropped instead.
+   *
+   * @param samples Pointer to the mono samples.
+   * @param frame_count Number of mono frames to write.
+   * @return Bytes queued, 0 when the frame was dropped for backpressure, -1 on error,
+   *         or -2 when the PipeWire connection became unavailable.
+   */
+  int
+  write(const std::int16_t *samples, std::size_t frame_count);
+}  // namespace platf::mic_redirect
