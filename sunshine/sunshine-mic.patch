+    device.events = {};
+    device.events.version = PW_VERSION_STREAM_EVENTS;
+    device.events.state_changed = on_stream_state_changed;
+    device.events.process = on_process;
+
+    auto *stream_properties = pw_properties_new(
+      PW_KEY_NODE_NAME, feed_node_name,
+      PW_KEY_NODE_DESCRIPTION, "Sunshine microphone feed",
+      PW_KEY_MEDIA_TYPE, "Audio",
+      PW_KEY_MEDIA_CATEGORY, "Playback",
+      PW_KEY_MEDIA_ROLE, "Communication",
+      PW_KEY_NODE_AUTOCONNECT, "false",
+      PW_KEY_NODE_DONT_RECONNECT, "true",
+      nullptr);
+
+    device.stream = pw_stream_new(device.core, "sunshine-mic", stream_properties);
+    if (!device.stream) {
+      return abandon("couldn't create the PipeWire feed stream"sv);
+    }
+
+    pw_stream_add_listener(device.stream, &device.stream_listener, &device.events, &device);
+
+    spa_audio_info_raw audio_info {};
+    audio_info.format = SPA_AUDIO_FORMAT_S16;
+    audio_info.rate = sample_rate;
+    audio_info.channels = 1;
+    audio_info.position[0] = SPA_AUDIO_CHANNEL_MONO;
+
+    std::uint8_t pod_buffer[1024];
+    spa_pod_builder builder = SPA_POD_BUILDER_INIT(pod_buffer, sizeof(pod_buffer));
+    const spa_pod *params[1] {spa_format_audio_raw_build(&builder, SPA_PARAM_EnumFormat, &audio_info)};
+
+    const auto flags = static_cast<pw_stream_flags>(PW_STREAM_FLAG_MAP_BUFFERS | PW_STREAM_FLAG_RT_PROCESS);
+    if (pw_stream_connect(device.stream, PW_DIRECTION_OUTPUT, PW_ID_ANY, flags, params, 1) < 0) {
+      return abandon("couldn't connect the PipeWire feed stream"sv);
+    }
+
+    if (!await([&] {
+          return device.feed_node_id.load(std::memory_order_acquire) != PW_ID_ANY &&
+                 device.feed_port_id.load(std::memory_order_acquire) != PW_ID_ANY;
+        })) {
+      return abandon("couldn't find the PipeWire microphone feed node"sv);
+    }
+
+    // A playback stream cannot be routed into a source node by session-manager policy, so the
+    // link that carries the audio is created here.
+    auto *link_properties = pw_properties_new(
+      PW_KEY_LINK_OUTPUT_NODE, std::to_string(device.feed_node_id.load(std::memory_order_acquire)).c_str(),
+      PW_KEY_LINK_OUTPUT_PORT, std::to_string(device.feed_port_id.load(std::memory_order_acquire)).c_str(),
+      PW_KEY_LINK_INPUT_NODE, std::to_string(device.source_node_id.load(std::memory_order_acquire)).c_str(),
+      PW_KEY_LINK_INPUT_PORT, std::to_string(device.source_port_id.load(std::memory_order_acquire)).c_str(),
+      nullptr);
+
+    device.link = static_cast<pw_proxy *>(
+      pw_core_create_object(device.core, link_factory, PW_TYPE_INTERFACE_Link, PW_VERSION_LINK, &link_properties->dict, 0));
+    pw_properties_free(link_properties);
+
+    if (!device.link) {
+      return abandon("couldn't link the feed stream into the virtual microphone"sv);
+    }
+
+    pw_thread_loop_unlock(device.loop);
+
+    device.failure_logged = false;
+    BOOST_LOG(info) << "Virtual microphone ["sv << source_node_name << "] created"sv;
+    return 0;
+  }
+
+  void release() {
+    std::lock_guard<std::mutex> lock(device.mutex);
+    if (!device.loop && !device.context) {
+      return;
+    }
+
+    if (device.loop) {
+      pw_thread_loop_lock(device.loop);
+    }
+
+    destroy();
+
+    if (device.loop) {
+      pw_thread_loop_unlock(device.loop);
+    }
+
+    if (device.context) {
+      pw_context_destroy(device.context);
+      device.context = nullptr;
+    }
+
+    if (device.loop) {
+      pw_thread_loop_stop(device.loop);
+      pw_thread_loop_destroy(device.loop);
+      device.loop = nullptr;
+    }
+
+    device.ring.head.store(0, std::memory_order_relaxed);
+    device.ring.tail.store(0, std::memory_order_relaxed);
+
+    BOOST_LOG(info) << "Virtual microphone released"sv;
+  }
+
+  int write(const std::int16_t *samples, std::size_t frame_count) {
+    if (!samples || frame_count == 0) {
+      return -1;
+    }
+
+    std::lock_guard<std::mutex> lock(device.mutex);
+    if (!device.stream) {
+      return -1;
+    }
+    if (device.failed.load(std::memory_order_acquire)) {
+      // The connection to the daemon is gone: the caller re-creates the device.
+      return -2;
+    }
+
+    // A stream that is merely idle (nothing is recording the virtual microphone yet) is
+    // healthy, so it drops frames instead of reporting a failure.
+    if (!device.connected.load(std::memory_order_acquire) || device.ring.push(samples, frame_count) == 0) {
+      // Dropping a frame keeps the host audio path real-time; the client's own jitter
+      // buffer absorbs the loss.
+      return 0;
+    }
+
+    pw_stream_trigger_process(device.stream);
+    return static_cast<int>(frame_count * sizeof(std::int16_t));
+  }
+}  // namespace platf::mic_redirect
