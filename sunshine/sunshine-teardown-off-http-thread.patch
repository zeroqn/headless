      * @brief Stop the active streaming session and prevent new packets from being queued.
      */
     void stop(session_t &session) {
-      while_starting_do_nothing(session.state);
+      // A session that is still starting cannot be stopped yet, and waiting for it here is
+      // unbounded work: this is called from the nvhttp request thread on a reconnect, where a
+      // session stuck in STARTING would hang the request (and the session mutex) forever. Give
+      // the state change a short window, then leave the session to the RTSP loop's cleanup,
+      // which finds it once its own threads settle.
+      for (int waited = 0; waited < 250 && session.state.load(std::memory_order_acquire) == state_e::STARTING; ++waited) {
+        std::this_thread::sleep_for(1ms);
+      }
+
       auto expected = state_e::RUNNING;
       auto already_stopping = !session.state.compare_exchange_strong(expected, state_e::STOPPING);
       if (already_stopping) {
