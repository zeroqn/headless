     /**
+     * @brief Clear sessions belonging to one client identity.
+     *
+     * A client that reconnects (a network drop, a resumed stream) opens a new RTSP session while its
+     * previous one is still counting down its ping timeout. Dropping the previous session here keeps
+     * one encoder per physical client instead of one per connection attempt.
+     *
+     * @param identity Client certificate or Moonlight unique id of the reconnecting client.
+     * @return Number of sessions that were terminated.
+     */
+    int clear_by_identity(std::string_view identity) {
+      auto lg = _session_slots.lock();
+      int cleared = 0;
+      for (auto i = _session_slots->begin(); i != _session_slots->end();) {
+        auto &slot = *(*i);
+        if (!identity.empty() && stream::session::client_identity(slot) == identity) {
+          stream::session::stop(slot);
+          stream::session::join(slot);
+          i = _session_slots->erase(i);
+          ++cleared;
+        } else {
+          i++;
+        }
+      }
+      return cleared;
+    }
+
