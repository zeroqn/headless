         clipboard.set(ty, text);
     }
 
+    pub fn copy_selection_on_pointer_release(
+        &mut self,
+        copy_on_select: bool,
+        clipboard: &mut Clipboard,
+    ) {
+        for &ty in pointer_release_clipboard_targets(copy_on_select) {
